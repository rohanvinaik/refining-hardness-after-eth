import ExactSolution.Observation

/-!
# Informational observability and realizable decoders

The observation vector contains all answers available in the chosen observation
language.  Observability means that the task is constant on its fibres inside
the admissible class.  The decoder below chooses an admissible representative
only for realizable vectors; it makes no computability or efficiency claim.
-/

namespace ExactSolution

def observationVector {C E A : Type*} (observe : E → C → A) (f : C) : E → A :=
  fun e => observe e f

def IsObservable {C E A Y : Type*} (admissible : Set C)
    (observe : E → C → A) (task : C → Y) : Prop :=
  ∀ f ∈ admissible, ∀ g ∈ admissible,
    observationVector observe f = observationVector observe g → task f = task g

/-- Only vectors generated by an admissible object need a decoded answer. -/
def RealizableObservation {C E A : Type*} (admissible : Set C)
    (observe : E → C → A) :=
  {v : E → A // ∃ f ∈ admissible, observationVector observe f = v}

def realizedObservation {C E A : Type*} (admissible : Set C)
    (observe : E → C → A) (f : C) (hf : f ∈ admissible) :
    RealizableObservation admissible observe :=
  ⟨observationVector observe f, f, hf, rfl⟩

/-- Choice constructs a decoder on realizable vectors, without an algorithmic bound. -/
noncomputable def observationDecoder {C E A Y : Type*} (admissible : Set C)
    (observe : E → C → A) (task : C → Y) :
    RealizableObservation admissible observe → Y :=
  fun v => task (Classical.choose v.property)

theorem observationDecoder_correct {C E A Y : Type*} {admissible : Set C}
    {observe : E → C → A} {task : C → Y}
    (h : IsObservable admissible observe task) (f : C) (hf : f ∈ admissible) :
    observationDecoder admissible observe task (realizedObservation admissible observe f hf) =
      task f := by
  let v := realizedObservation admissible observe f hf
  have hw := Classical.choose_spec v.property
  exact h (Classical.choose v.property) hw.1 f hf hw.2

theorem observable_iff_exists_decoder {C E A Y : Type*}
    (admissible : Set C) (observe : E → C → A) (task : C → Y) :
    IsObservable admissible observe task ↔
      ∃ decoder : RealizableObservation admissible observe → Y,
        ∀ f (hf : f ∈ admissible),
          decoder (realizedObservation admissible observe f hf) = task f := by
  constructor
  · intro h
    exact ⟨observationDecoder admissible observe task, observationDecoder_correct h⟩
  · rintro ⟨decoder, hdecoder⟩ f hf g hg hfg
    have hv : realizedObservation admissible observe f hf =
        realizedObservation admissible observe g hg := Subtype.ext hfg
    calc
      task f = decoder (realizedObservation admissible observe f hf) := (hdecoder f hf).symm
      _ = decoder (realizedObservation admissible observe g hg) := congrArg decoder hv
      _ = task g := hdecoder g hg

/-- Finite complete observations suffice exactly when they separate task values. -/
theorem all_certificates_iff_observable {C E A Y : Type*} [Fintype E]
    (admissible : Set C) (observe : E → C → A) (task : C → Y) :
    (∀ f ∈ admissible, ∃ T : Finset E, IsCertificate admissible observe task f T) ↔
      IsObservable admissible observe task := by
  classical
  constructor
  · intro h f hf g hg hfg
    obtain ⟨T, hT⟩ := h f hf
    apply Eq.symm
    apply hT g hg
    intro e _
    exact (congrFun hfg e).symm
  · intro h f hf
    refine ⟨Finset.univ, ?_⟩
    intro g hg hgf
    apply Eq.symm
    apply h f hf g hg
    exact funext (fun e => (hgf e (Finset.mem_univ e)).symm)

/-- The certificate formulation and an actual decoder agree for finite observation languages. -/
theorem all_certificates_iff_exists_decoder {C E A Y : Type*} [Fintype E]
    (admissible : Set C) (observe : E → C → A) (task : C → Y) :
    (∀ f ∈ admissible, ∃ T : Finset E, IsCertificate admissible observe task f T) ↔
      ∃ decoder : RealizableObservation admissible observe → Y,
        ∀ f (hf : f ∈ admissible),
          decoder (realizedObservation admissible observe f hf) = task f := by
  exact (all_certificates_iff_observable admissible observe task).trans
    (observable_iff_exists_decoder admissible observe task)

/-- No choice of observations removes a task-changing full-observation ambiguity. -/
theorem indistinguishable_no_certificate {C E A Y : Type*} {admissible : Set C}
    {observe : E → C → A} {task : C → Y} {f g : C}
    (hg : g ∈ admissible)
    (hfg : observationVector observe f = observationVector observe g)
    (htask : task g ≠ task f) (T : Finset E) :
    ¬ IsCertificate admissible observe task f T := by
  intro hT
  apply htask
  apply hT g hg
  intro e _
  exact (congrFun hfg e).symm

theorem ambiguity_complexity_top {C E A Y : Type*} {admissible : Set C}
    {observe : E → C → A} {task : C → Y} {f g : C}
    (hg : g ∈ admissible)
    (hfg : observationVector observe f = observationVector observe g)
    (htask : task g ≠ task f) :
    certificateComplexity admissible observe task f = ⊤ := by
  apply le_antisymm le_top
  apply le_complexity
  intro T hT
  exact False.elim (indistinguishable_no_certificate hg hfg htask T hT)

theorem ambiguity_no_decoder {C E A Y : Type*} {admissible : Set C}
    {observe : E → C → A} {task : C → Y} {f g : C}
    (hf : f ∈ admissible) (hg : g ∈ admissible)
    (hfg : observationVector observe f = observationVector observe g)
    (htask : task g ≠ task f) :
    ¬ ∃ decoder : RealizableObservation admissible observe → Y,
      ∀ x (hx : x ∈ admissible),
        decoder (realizedObservation admissible observe x hx) = task x := by
  intro hdecoder
  have h := (observable_iff_exists_decoder admissible observe task).mpr hdecoder
  exact htask (h f hf g hg hfg).symm

end ExactSolution
